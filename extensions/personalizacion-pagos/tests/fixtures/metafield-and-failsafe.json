{
  "payload": {
    "export": "cart_payment_methods_transform_run",
    "target": "cart.payment-methods.transform.run",
    "input": {
      "cart": {
        "lines": [
          {
            "merchandise": {
              "__typename": "ProductVariant",
              "sku": "MF-100",
              "product": {
                "id": "gid://shopify/Product/3",
                "title": "Equipo Especial",
                "productType": "Equipo",
                "vendor": "SmartMob",
                "hasTags": [],
                "inCollections": [
                  { "collectionId": "gid://shopify/Collection/1", "isMember": true }
                ],
                "mf0": { "value": "reacondicionado" },
                "mf1": { "value": "500" },
                "mf2": null,
                "mf3": null
              }
            }
          }
        ]
      },
      "paymentMethods": [
        { "id": "gid://shopify/PaymentCustomizationPaymentMethod/1", "name": "Transferencia directa" },
        { "id": "gid://shopify/PaymentCustomizationPaymentMethod/2", "name": "Pago en tienda" }
      ],
      "paymentCustomization": {
        "metafield": {
          "jsonValue": {
            "failSafe": true,
            "rules": [
              {
                "cartMatch": "any",
                "conditionLogic": "all",
                "conditions": [
                  { "field": "metafield", "operator": "equals", "value": "reacondicionado", "metafieldSlot": 0 },
                  { "field": "collection", "operator": "in", "value": "gid://shopify/Collection/1", "metafieldSlot": -1 }
                ],
                "action": "allow_only_selected",
                "targets": [
                  { "pattern": "transferencia directa", "matchType": "contains" }
                ]
              },
              {
                "cartMatch": "any",
                "conditionLogic": "all",
                "conditions": [
                  { "field": "metafield", "operator": "gte", "value": "500", "metafieldSlot": 1 }
                ],
                "action": "hide_selected",
                "targets": [
                  { "pattern": "transferencia directa", "matchType": "contains" }
                ]
              }
            ]
          }
        }
      }
    },
    "output": {
      "operations": []
    }
  }
}
