{
  "payload": {
    "export": "cart_payment_methods_transform_run",
    "target": "cart.payment-methods.transform.run",
    "input": {
      "cart": {
        "lines": [
          {
            "merchandise": {
              "__typename": "ProductVariant",
              "sku": "SRV-01",
              "product": {
                "id": "gid://shopify/Product/2",
                "title": "Servicio Técnico",
                "productType": "Servicio",
                "vendor": "SmartMob",
                "hasTags": [
                  { "tag": "servicio-tecnico", "hasTag": true }
                ],
                "inCollections": [],
                "mf0": null,
                "mf1": null,
                "mf2": null,
                "mf3": null
              }
            }
          }
        ]
      },
      "paymentMethods": [
        { "id": "gid://shopify/PaymentCustomizationPaymentMethod/1", "name": "Transferencia directa" },
        { "id": "gid://shopify/PaymentCustomizationPaymentMethod/2", "name": "Pago en tienda" },
        { "id": "gid://shopify/PaymentCustomizationPaymentMethod/3", "name": "Tarjeta de crédito" }
      ],
      "paymentCustomization": {
        "metafield": {
          "jsonValue": {
            "failSafe": true,
            "rules": [
              {
                "cartMatch": "any",
                "conditionLogic": "all",
                "conditions": [
                  { "field": "tag", "operator": "equals", "value": "servicio-tecnico", "metafieldSlot": -1 }
                ],
                "action": "hide_selected",
                "targets": [
                  { "pattern": "pago en tienda", "matchType": "contains" }
                ]
              }
            ]
          }
        }
      }
    },
    "output": {
      "operations": [
        {
          "paymentMethodHide": {
            "paymentMethodId": "gid://shopify/PaymentCustomizationPaymentMethod/2"
          }
        }
      ]
    }
  }
}
